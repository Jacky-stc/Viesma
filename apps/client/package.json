{
  "name": "@viesma/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w run build:shared && pnpm run dev:serve",
    "dev:serve": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "vite build"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.10",
    "@viesma/domain": "workspace:*",
    "@viesma/game-data": "workspace:*",
    "@viesma/network-colyseus": "workspace:*",
    "@viesma/physics": "workspace:*",
    "@viesma/protocol": "workspace:*",
    "@viesma/simulation": "workspace:*",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
