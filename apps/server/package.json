{
  "name": "@viesma/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @viesma/simulation... --filter @viesma/network-colyseus... run build && node --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@colyseus/core": "0.18.29",
    "@colyseus/schema": "5.0.50",
    "@colyseus/ws-transport": "0.18.5",
    "@viesma/domain": "workspace:*",
    "@viesma/game-data": "workspace:*",
    "@viesma/network-colyseus": "workspace:*",
    "@viesma/protocol": "workspace:*",
    "@viesma/simulation": "workspace:*",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2"
  }
}
