{
  "name": "viesma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "pnpm run build:shared && pnpm -r --parallel --filter \"./apps/*\" run dev:serve",
    "build:shared": "pnpm --filter @viesma/simulation... --filter @viesma/network-colyseus... run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && pnpm run check:boundaries",
    "check:boundaries": "node tools/check-workspace-dependencies.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "node tools/run-smoke.mjs",
    "test:acceptance:m4.5": "node apps/server/test/run-shared-combat-endurance.mjs",
    "validate:maps": "pnpm --filter @viesma/game-data... run build && node apps/server/tools/validate-maps.mjs",
    "validate:assets": "node apps/client/tools/validate-assets.ts",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
